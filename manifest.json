{
  "manifest_version": 3,
  "name": "Workspace Links",
  "description": "Share Google Docs, Sheets, Slides and Drawings as copy, preview or template links, and download them as PDF, CSV, PNG or SVG.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Workspace Links",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "downloads"]
}
